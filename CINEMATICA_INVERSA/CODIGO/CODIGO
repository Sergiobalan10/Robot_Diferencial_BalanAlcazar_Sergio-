%% FIGURA 8. VELOCIDADES DE LAS RUEDAS
fig8 = figure(8);
subplot(2,1,1)
plot(t, VD, 'Color', colorPrincipal, 'LineWidth', 3)
hold on
plot(t, VI, '--', 'Color', colorSecundario, 'LineWidth', 3)
grid on
title('Velocidades lineales de las ruedas')
xlabel('Tiempo [s]')
ylabel('Velocidad [m/s]')
legend('Rueda derecha', 'Rueda izquierda', 'Location', 'best')
set(gca, 'FontSize', 12)

subplot(2,1,2)
plot(t, thetaDot_D, 'Color', colorPrincipal, 'LineWidth', 3)
hold on
plot(t, thetaDot_I, '--', 'Color', colorSecundario, 'LineWidth', 3)
grid on
title('Velocidades angulares de las ruedas')
xlabel('Tiempo [s]')
ylabel('\omega [rad/s]')
legend('Rueda derecha', 'Rueda izquierda', 'Location', 'best')
set(gca, 'FontSize', 12)

exportgraphics(fig8, fullfile(nombre_carpeta, '08_velocidades_ruedas.png'), 'Resolution', 300);

%% =========================================================
% FIGURA 9. ANIMACIÓN Y EXPORTACIÓN A VÍDEO (.MP4) Y GIF
% =========================================================
fprintf('Generando animacion, vídeo e imágenes...\n');

fig9 = figure(9);
clf
set(fig9, 'Position', [150 80 900 700], 'Color', 'k')

xmin = min([x xd]) - 0.5;
xmax = max([x xd]) + 0.5;
ymin = min([y yd]) - 0.5;
ymax = max([y yd]) + 0.5;

% Configuración de archivo GIF
nombre_gif = fullfile(nombre_carpeta, 'animacion_robot.gif');

% Configuración del Vídeo MP4
nombre_mp4 = fullfile(nombre_carpeta, 'animacion_robot.mp4');
video = VideoWriter(nombre_mp4, 'MPEG-4');
video.FrameRate = 30;
open(video);

k_contador = 1;
for k = 1:5:length(t)

    clf
    set(gca, 'Color', 'k', 'XColor', 'w', 'YColor', 'w');
    hold on

    % Trayectoria completa de referencia (gris tenue)
    plot(xd, yd, '--', 'Color', [0.4 0.4 0.4], 'LineWidth', 1.5);

    % Trayectoria recorrida
    plot(xd(1:k), yd(1:k), 'Color', colorPrincipal, 'LineWidth', 3);

    % Robot: Círculo azul vibrante con borde blanco
    plot(xd(k), yd(k), 'o', 'MarkerFaceColor', [0 0.4 1], 'MarkerEdgeColor', 'w', 'MarkerSize', 12, 'LineWidth', 1.5);

    % Flecha de orientación: Raya roja gruesa
    quiver(xd(k), yd(k), 0.25*cos(theta(k)), 0.25*sin(theta(k)), 0, 'Color', [1 0 0], 'LineWidth', 3, 'MaxHeadSize', 2);

    % Punto de inicio: Cuadrado naranja fijo
    plot(xd(1), yd(1), 's', 'MarkerFaceColor', [1 0.5 0], 'MarkerEdgeColor', 'w', 'MarkerSize', 8, 'LineWidth', 1.5);

    % Punto final destino: Estrella verde brillante fija
    plot(xd(end), yd(end), 'p', 'MarkerFaceColor', [0 1 0], 'MarkerEdgeColor', 'w', 'MarkerSize', 12, 'LineWidth', 1.5);

    axis equal
    axis([xmin xmax ymin ymax])
    grid on
    box on

    xlabel('X [m]', 'Color', 'w')
    ylabel('Y [m]', 'Color', 'w')
    title(sprintf('Animacion de la trayectoria - t = %.2f s / %.2f s', t(k), ts), 'Color', 'w', 'FontSize', 12)

    drawnow

    % Captura de cuadro para Vídeo MP4
    frame = getframe(fig9);
    writeVideo(video, frame);

    % Captura de cuadro para GIF Animado
    im = frame2im(frame);
    [A, map] = rgb2ind(im, 256);

    if k_contador == 1
        imwrite(A, map, nombre_gif, 'gif', 'LoopCount', Inf, 'DelayTime', 0.05);
    else
        imwrite(A, map, nombre_gif, 'gif', 'WriteMode', 'append', 'DelayTime', 0.05);
    end
    k_contador = k_contador + 1;
end

% Congelar el cuadro final 1 segundo en el vídeo
for i = 1:30
    frame = getframe(fig9);
    writeVideo(video, frame);
end

% Guardar la captura final PNG de la animación
exportgraphics(fig9, fullfile(nombre_carpeta, '09_animacion_cuadro_final.png'), 'Resolution', 300);

close(video);

fprintf('\n¡Proceso finalizado con éxito!\n');
fprintf('Todos los archivos fueron guardados en la carpeta: "%s"\n', nombre_carpeta);
