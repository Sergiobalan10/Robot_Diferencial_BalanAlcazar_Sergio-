plot(xd, yd, 'Color', colorPrincipal, 'LineWidth', 3)
hold on
plot(xd(1), yd(1), 's', 'MarkerSize', 10, 'MarkerFaceColor', [1 0.5 0], 'MarkerEdgeColor', 'w', 'LineWidth', 1.5)
plot(xd(end), yd(end), 'p', 'MarkerSize', 12, 'MarkerFaceColor', [0 1 0], 'MarkerEdgeColor', 'w', 'LineWidth', 1.5)
