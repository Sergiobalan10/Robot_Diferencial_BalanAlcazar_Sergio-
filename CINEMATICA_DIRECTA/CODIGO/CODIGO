%% CINEMÁTICA DIRECTA - ROBOT DIFERENCIAL
clear all;
clc;
close all;

%% PARÁMETROS GENERALES DEL ROBOT
ts = 7;              % Tiempo de simulación [s]
ti = 0.04;           % Tiempo de integración [s]
t = 0:ti:ts;
L = 0.30;            % Distancia entre ruedas [m]
r = 0.05;            % Radio de la rueda [m]

numCasos = 8;
resultados = struct();

%% 1. SIMULACIÓN, GENERACIÓN DE VIDEOS E IMÁGENES INDIVIDUALES (CASOS 1 AL 8)
for caso = 1:numCasos
    
    switch caso
        case 1
            thetaDot_D = 14; thetaDot_I = 14;
            movimiento = 'Avance rectilíneo';
            trajColor = [1, 0, 0]; % Rojo
        case 2
            thetaDot_D = -14; thetaDot_I = -14;
            movimiento = 'Retroceso rectilíneo';
            trajColor = [0, 1, 1]; % Cian
        case 3
            thetaDot_D = 15; thetaDot_I = 7;
            movimiento = 'Curva izq. amplia';
            trajColor = [1, 0, 1]; % Magenta
        case 4
            thetaDot_D = 7; thetaDot_I = 15;
            movimiento = 'Curva der. amplia';
            trajColor = [0, 1, 0]; % Verde
        case 5
            thetaDot_D = 18; thetaDot_I = -18;
            movimiento = 'Rotación sobre eje';
            trajColor = [1, 0.5, 0]; % Naranja
        case 6
            thetaDot_D = 15; thetaDot_I = 0;
            movimiento = 'Rueda int. bloqueada';
            trajColor = [0.5, 0, 1]; % Violeta
        case 7
            thetaDot_D = 12; thetaDot_I = 9;
            movimiento = 'Curvilíneo suave';
            trajColor = [1, 1, 0]; % Amarillo
        case 8
            thetaDot_D = 16; thetaDot_I = 3;
            movimiento = 'Helicoidal pronunciada';
            trajColor = [0, 0.7, 1]; % Azul cielo
    end
    
    x = zeros(1, length(t));
    y = zeros(1, length(t));
    theta = zeros(1, length(t));
    
    u = (r/2)*(thetaDot_D + thetaDot_I);
    w = (r/L)*(thetaDot_D - thetaDot_I);
    
    for k = 1:length(t)-1
        x(k+1) = x(k) + ti*u*cos(theta(k));
        y(k+1) = y(k) + ti*u*sin(theta(k));
        theta(k+1) = theta(k) + ti*w;
    end
    
    % Guardar datos calculados
    resultados(caso).x = x;
    resultados(caso).y = y;
    resultados(caso).theta = theta;
    resultados(caso).color = trajColor;
    resultados(caso).movimiento = movimiento;
    
    % Ventana para generar la simulación y video
    figAnim = figure('Color','k', 'Position', [100 100 800 800]);
    hold on; grid on; axis equal;
    
    maxDim = max(max(abs(x)), max(abs(y)));
    lim = max(maxDim + 0.5, 0.8);
    resultados(caso).lim = lim;
    
    nombreVideo = sprintf('Caso%d.mp4', caso);
    video = VideoWriter(nombreVideo, 'MPEG-4');
    video.FrameRate = 30;
    open(video);
    
    historyX = []; historyY = [];
    
    for k = 1:3:length(t)
        cla;
        set(gca, 'Color', 'k', 'XColor', 'w', 'YColor', 'w');
        grid on;
        
        plot(x, y, 'Color', [0.7 0.7 0.7], 'LineWidth', 1.2, 'LineStyle', ':');
        
        historyX = [historyX, x(k)]; historyY = [historyY, y(k)];
        scatter(historyX, historyY, 20, trajColor, 'filled', 'MarkerFaceAlpha', 0.8);
        
        plot(x(1), y(1), 's', 'MarkerFaceColor', [1 0.4 0], 'MarkerEdgeColor', 'w', 'MarkerSize', 10, 'LineWidth', 1.5);
        plot(x(end), y(end), 'p', 'MarkerFaceColor', [0 1 0], 'MarkerEdgeColor', 'w', 'MarkerSize', 13, 'LineWidth', 1.5);
        plot(x(k), y(k), 'o', 'MarkerFaceColor', [0 0.4 1], 'MarkerEdgeColor', 'w', 'MarkerSize', 12, 'LineWidth', 2);
        quiver(x(k), y(k), 0.25*cos(theta(k)), 0.25*sin(theta(k)), 0, 'Color', [1 0 0], 'LineWidth', 3);
        
        axis equal; xlim([-lim lim]); ylim([-lim lim]);
        xlabel('X [m]', 'Color', 'w'); ylabel('Y [m]', 'Color', 'w');
        title(sprintf('Caso %d - %s', caso, movimiento), 'Color', 'w');
        
        frame = getframe(figAnim);
        writeVideo(video, frame);
    end
    
    % Guardar último cuadro en el video
    for i = 1:30
        frame = getframe(figAnim);
        writeVideo(video, frame);
    end
    
    % EXPORTAR IMAGEN FINAL DEL CASO
    nombreImagen = sprintf('Caso%d.png', caso);
    saveas(figAnim, nombreImagen);
    
    close(video);
    close(figAnim);
    fprintf('Guardado: Caso%d.mp4 y Caso%d.png\n', caso, caso);
end

%% 2. GENERACIÓN DEL VIDEO Y LA IMAGEN COMPARATIVA (MOSAICO 2x4)
fprintf('\nGenerando video e imagen comparativa completa...\n');

figComp = figure('Color', 'k', 'Position', [100 100 1280 720]);
sgtitle('CINEMÁTICA DIRECTA - COMPARATIVA DE TRAYECTORIAS', 'Color', 'w', 'FontSize', 14, 'FontWeight', 'bold');

videoComp = VideoWriter('Comparativa_Todos_los_Casos.mp4', 'MPEG-4');
videoComp.FrameRate = 30;
open(videoComp);

% Bucle de animación simultánea
for k = 1:3:length(t)
    for caso = 1:numCasos
        subplot(2, 4, caso);
        cla;
        set(gca, 'Color', 'k', 'XColor', 'w', 'YColor', 'w');
        grid on; hold on; axis equal;
        
        xk = resultados(caso).x(1:k);
        yk = resultados(caso).y(1:k);
        c = resultados(caso).color;
        lim = resultados(caso).lim;
        
        % Trayectoria punteada de fondo completa
        plot(resultados(caso).x, resultados(caso).y, 'Color', [0.4 0.4 0.4], 'LineWidth', 1, 'LineStyle', ':');
        
        % Estela del robot en el instante k
        plot(xk, yk, 'Color', c, 'LineWidth', 2);
        
        % Marcadores inicio, fin y actual
        plot(resultados(caso).x(1), resultados(caso).y(1), 's', 'MarkerFaceColor', [1 0.4 0], 'MarkerEdgeColor', 'w', 'MarkerSize', 5);
        plot(resultados(caso).x(end), resultados(caso).y(end), 'p', 'MarkerFaceColor', [0 1 0], 'MarkerEdgeColor', 'w', 'MarkerSize', 6);
        plot(resultados(caso).x(k), resultados(caso).y(k), 'o', 'MarkerFaceColor', [0 0.4 1], 'MarkerEdgeColor', 'w', 'MarkerSize', 7);
        
        % Vector orientación
        quiver(resultados(caso).x(k), resultados(caso).y(k), ...
               0.2*cos(resultados(caso).theta(k)), 0.2*sin(resultados(caso).theta(k)), ...
               0, 'Color', [1 0 0], 'LineWidth', 1.5);
        
        xlim([-lim lim]); ylim([-lim lim]);
        title(sprintf('Caso %d: %s', caso, resultados(caso).movimiento), 'Color', 'w', 'FontSize', 8);
    end
    
    drawnow;
    frameComp = getframe(figComp);
    writeVideo(videoComp, frameComp);
end

% Mantener el cuadro final en el video por 2 segundos
for i = 1:60
    frameComp = getframe(figComp);
    writeVideo(videoComp, frameComp);
end

% EXPORTAR IMAGEN DEL MOSAICO COMPARATIVO COMPLETO
saveas(figComp, 'Comparativa_Todos_los_Casos.png');

close(videoComp);
close(figComp);

fprintf('\n¡Proceso finalizado con éxito!\n');
fprintf('Se generaron en total:\n');
fprintf(' - 9 Archivos de Vídeo (.mp4): Caso1 a Caso8 + Comparativa_Todos_los_Casos.mp4\n');
fprintf(' - 9 Archivos de Imagen (.png): Caso1.png a Caso8.png + Comparativa_Todos_los_Casos.png\n');
